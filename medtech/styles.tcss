/* Palette values live in themes.json; user palettes share the same visual system. */
Screen {
    layout: vertical;
    background: $background;
    color: $foreground;
    scrollbar-color: $medtech-border;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $accent;
    scrollbar-background: $background;
    scrollbar-background-hover: $surface;
    scrollbar-size: 1 1;
}

#body { height: 1fr; }
#sidebar {
    width: 30;
    min-width: 24;
    background: $surface;
    border: round $medtech-border;
    margin: 1 0 1 1;
    padding: 1;
}
#sidebar.hidden { display: none; }
#brand { height: 2; text-style: bold; color: $primary; padding: 0 1; }
#new-chat { width: 100%; height: 3; min-height: 3; margin: 0 0 1 0; }
#memory, #themes { width: 100%; height: 1; min-height: 1; padding: 0 1; margin: 0; border: none; background: transparent; text-align: left; color: $medtech-muted; }
#memory:hover, #themes:hover { background: $medtech-hover; color: $foreground; }
#memory:focus, #themes:focus { background: $medtech-selected; color: $primary; text-style: bold; }
#new-chat { background: $primary 16%; color: $foreground; border: round $primary 65%; }
#new-chat:hover { background: $primary 28%; border: round $primary; }
#chat-search { height: 3; margin-bottom: 1; background: $background; border: round $medtech-border; }
#chat-search:focus { border: round $primary; }
#chat-list { height: 1fr; background: transparent; padding-right: 1; }
#chat-list:focus { border: none; }
#chat-list ListItem { height: 2; padding: 0 1; color: $foreground; background: transparent; }
#chat-list ListItem:hover { background: $medtech-hover; }
#chat-list ListItem.current { background: $medtech-selected; border-left: thick $primary; text-style: bold; }
#chat-list ListItem.-highlight { background: $medtech-selected; color: $foreground; }
#chat-list .date-group { height: 2; padding-top: 1; color: $medtech-muted; text-style: bold; background: transparent; }
#chat-list .date-group:hover { background: transparent; }
#sidebar-footer { height: auto; max-height: 6; padding: 1 1 0 1; border-top: solid $medtech-border; color: $medtech-muted; }
#main { width: 1fr; min-width: 20; }
#chat-title { height: 3; padding: 1 3 0 3; text-style: bold; color: $foreground; }
#context-bar { height: 2; padding: 0 3; color: $medtech-muted; }
#transcript { height: 1fr; padding: 1 3; align-horizontal: center; }
.bubble { width: 1fr; max-width: 120; height: auto; padding: 1 2; margin-bottom: 1; border: round $medtech-border; }
.bubble.user { background: $medtech-user; margin-left: 4; border: round $primary 35%; }
.bubble.assistant { background: $medtech-assistant; margin-right: 3; }
.speaker { height: 1; margin-bottom: 1; text-style: bold; color: $primary; }
.user .speaker { color: $accent; }
.bubble Markdown { background: transparent; padding: 0; margin: 0; }
.bubble MarkdownH1, .bubble MarkdownH2, .bubble MarkdownH3 { color: $foreground; background: transparent; }
.bubble MarkdownFence { background: $medtech-code; border: round $medtech-border; padding: 0 1; margin: 1 0; }
.notice { width: 1fr; max-width: 120; height: auto; padding: 0 1; margin-bottom: 1; color: $medtech-muted; }
#draft { border: round $warning 65%; background: $medtech-assistant; }
.draft-label { height: 1; margin-bottom: 1; color: $warning; text-style: italic; }
.outcome { width: 1fr; max-width: 120; height: auto; padding: 0 2; margin: 0 0 1 0; }
.outcome.success { color: $success; border-left: thick $success; }
.outcome.failure { color: $error; border-left: thick $error; }
Collapsible { width: 1fr; max-width: 120; padding: 0 1; margin: 0 0 1 0; background: $surface; border: round $medtech-border; }
Collapsible > Contents { padding: 0 1 1 1; }
CollapsibleTitle { color: $medtech-muted; }
CollapsibleTitle:hover { color: $primary; background: $medtech-hover; }
#composer { height: auto; min-height: 5; max-height: 12; padding: 1 3 0 3; border-top: solid $medtech-border; }
#message-input { width: 1fr; height: 5; min-height: 3; max-height: 10; background: $surface; border: round $medtech-border; padding: 0 1; }
#message-input:focus { border: round $primary; }
#send { width: 10; min-width: 8; height: 3; margin-left: 1; background: $primary; color: $background; border: round $primary; text-style: bold; }
#send:hover { background: $accent; border: round $accent; }
#send:disabled { background: $surface; color: $medtech-muted; border: round $medtech-border; }
#status-area { height: 2; padding: 0 3; align-vertical: middle; }
#status { width: 1fr; height: 1; color: $medtech-muted; }
#thinking { width: 4; height: 1; margin-right: 1; color: $primary; }
#details-label { width: auto; height: 1; margin-right: 1; color: $medtech-muted; }
#details-switch { width: 8; height: 1; border: none; padding: 0; }
Footer { height: 1; background: $surface; color: $medtech-muted; }
Footer > .footer--key { background: $panel; color: $primary; text-style: bold; }
Footer > .footer--description { color: $medtech-muted; }
Button { min-width: 10; background: $panel; color: $foreground; border: round $medtech-border; text-style: none; }
Button:hover { background: $medtech-hover; border: round $primary; }
Button:focus { border: round $primary; text-style: bold; }
Button.-primary { background: $primary; color: $background; border: round $primary; }
Button.-error { background: $error 12%; color: $error; border: round $error 65%; }
Button.-warning { background: $warning 16%; color: $warning; border: round $warning 65%; }

/* Shared dialogs have a bounded height and remain usable on small terminals. */
Dialog { align: center middle; background: $background 80%; }
Dialog > Vertical { width: 66; max-width: 94%; height: auto; max-height: 88%; padding: 1 2; background: $surface; border: round $primary; }
Dialog Label { height: auto; margin-bottom: 1; text-style: bold; color: $foreground; }
Dialog Static { height: auto; color: $medtech-muted; }
ConfirmToolDialog Static { max-height: 12; overflow-y: auto; }
Dialog Input { height: 3; background: $background; border: round $medtech-border; }
Dialog Input:focus { border: round $primary; }
Dialog Horizontal { height: auto; margin-top: 1; }
Dialog Button { margin-right: 1; height: 3; }
Dialog Select { width: 100%; margin-bottom: 1; }
ChatMenuDialog > Vertical { width: 42; }
ChatMenuDialog Button { width: 100%; margin-right: 0; margin-top: 1; }
MemoryDialog > Vertical { width: 82; height: 78%; }
MemoryDialog ListView { height: 1fr; background: $background; border: round $medtech-border; }
MemoryDialog ListItem { height: auto; padding: 1; background: transparent; }
MemoryDialog ListItem:hover { background: $medtech-hover; }
MemoryDialog ListItem Horizontal { height: auto; margin: 0; }
MemoryDialog ListItem Static { width: 1fr; color: $foreground; }
MemoryDialog ListItem Button { width: 10; min-width: 10; margin: 0 0 0 1; }
ThemeDialog > Vertical { width: 60; }
ThemeDialog Switch { margin-left: 1; }

/* The UI toggles this class when a narrow terminal needs a denser conversation. */
Screen.narrow #chat-title, Screen.narrow #context-bar { padding-left: 1; padding-right: 1; }
Screen.narrow #transcript { padding: 1; }
Screen.narrow .bubble { padding: 1; }
Screen.narrow .bubble.user { margin-left: 2; }
Screen.narrow .bubble.assistant { margin-right: 1; }
Screen.narrow #composer { padding-left: 1; padding-right: 1; }
Screen.narrow #status-area { padding-left: 1; padding-right: 1; }

/* Quiet new-chat welcome and examples, removed as soon as a message is sent. */
#welcome { width: 1fr; max-width: 86; height: auto; margin: 2 0; padding: 2 3; border: round $medtech-border; background: $surface; }
#welcome Static { height: auto; margin-bottom: 1; }
#welcome-title { color: $foreground; text-style: bold; }
.welcome-muted { color: $medtech-muted; }
.welcome-section { color: $primary; text-style: bold; }
#welcome-prompts { color: $foreground; padding: 1 2; border-left: thick $primary; background: $background; }
Screen.narrow #welcome { margin: 0; padding: 1; }
